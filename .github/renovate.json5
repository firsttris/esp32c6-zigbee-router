// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new ESPHome
// release, plus the "Dependency Dashboard" issue listing what is open. ESPHome is what the Zigbee
// router firmware (esp32-c6-zigbee-router.yaml) builds on: it brings the ESP-IDF framework, the
// toolchain and every component the YAML uses, so it is pinned to one exact release: the pin in
// requirements.txt (CI's pip install) and the image in docker-compose.yml, plus the `docker run`
// examples in README.md. They move together in one PR, whose build check validates and compiles the
// config with the new release. No external components, git packages or other pins exist here.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `npx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  customManagers: [
    {
      // The `docker run`/`podman run` examples in README.md name the same image tag
      customType: "regex",
      managerFilePatterns: ["/^README\\.md$/"],
      matchStrings: ["ghcr\\.io/esphome/esphome:(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "ghcr.io/esphome/esphome",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // The pip package and the image, in one PR so requirements.txt, docker-compose.yml and the
      // README cannot drift apart. Only releases like 2026.10.1: betas (2026.11.0b1) and the
      // image's nightly tags (2026.11.0-dev20261030) are left out.
      matchPackageNames: ["esphome", "ghcr.io/esphome/esphome"],
      groupName: "ESPHome",
      sourceUrl: "https://github.com/esphome/esphome",
      commitMessageTopic: "ESPHome",
      prBodyNotes: [
        "Before merging: read the [ESPHome changelog](https://esphome.io/changelog/) of every release between the old and the new pin, its **Breaking changes** first (a monthly release `YYYY.M.0` brings them, a patch release `YYYY.M.x` fixes bugs). Look for `zigbee` (the native component and the Zigbee SDK it brings), `esp32` (ESP-IDF version) and the partition table: a changed Zigbee stack or partition layout means the router has to be paired again, see README, *Upgrading from an Older Version*. The build check of this PR validates and compiles `esp32-c6-zigbee-router.yaml` with the new release. The router has no Wi-Fi: before merging, flash this branch onto **one** router over USB (`esphome logs --device=/dev/ttyACM0`) and check in Zigbee2MQTT/ZHA that it rejoins without a new pairing and still routes for its children. Then merge and update the other routers. The minimum version in the README badge and table stays unless the config starts to use something newer. If the build fails on a Python requirement of the new release, raise `python-version` in the workflows.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // pip (pep440) already leaves out the betas; the image also has nightly tags, so only
      // YYYY.M.x counts there
      matchPackageNames: ["ghcr.io/esphome/esphome"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      // The Python of the workflows (setup-python): ESPHome 2026.10.1 declares
      // requires_python "<3.15,>=3.12.0" (PyPI), so pip cannot install it on 3.15. Drop this rule
      // once an ESPHome release supports Python 3.15.
      matchPackageNames: ["python"],
      allowedVersions: "<3.15",
    },
  ],
}
